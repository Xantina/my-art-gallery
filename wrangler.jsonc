{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-art-gallery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
